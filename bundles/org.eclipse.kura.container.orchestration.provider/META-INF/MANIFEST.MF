Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Configurable container management component
Bundle-SymbolicName: org.eclipse.kura.container.orchestration.provider
Bundle-Version: 3.0.0.qualifier
Bundle-Vendor: Eclipse Kura
Automatic-Module-Name: org.eclipse.kura.container.orchestration.provider
Bundle-ActivationPolicy: lazy
Require-Capability: osgi.ee;filter:="(&(osgi.ee=JavaSE)(version=21))"
Import-Package: com.google.common.base;version="31.0.0",
 com.google.common.collect;version="32.1.1",
 com.google.common.escape;version="32.1.1",
 com.google.common.io;version="32.1.1",
 com.google.common.net;version="32.1.1",
 org.apache.commons.lang3;version="3.4.0",
 org.eclipse.kura;version="[1.6,2.0)",
 org.eclipse.kura.configuration;version="[1.2,2.0)",
 org.eclipse.kura.container.orchestration;version="[1.3,2.0)",
 org.eclipse.kura.container.orchestration.listener;version="[1.0,1.1)",
 org.eclipse.kura.crypto;version="[1.3,2.0]",
 org.eclipse.kura.util.configuration;version="[1.0,2.0)",
 org.osgi.service.component;version="1.4.0",
 org.slf4j;version="[1.7,3)"
Service-Component: OSGI-INF/component.xml
Bundle-ClassPath: .,
 commons-codec.jar,
 commons-compress.jar,
 commons-io.jar,
 commons-lang.jar,
 docker-java-api.jar,
 docker-java-core.jar,
 docker-java-transport.jar,
 docker-java-transport-httpclient5.jar,
 httpclient5.jar,
 httpcore5.jar,
 jackson-annotations.jar,
 jackson-core.jar,
 jackson-databind.jar,
 jna.jar
